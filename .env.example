# FastAPI Backend Database & Redis Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/llm_evalops
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
DASHBOARD_CACHE_TTL_SECONDS=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002,http://localhost:3003,http://127.0.0.1:3003

# LLM Provider Credentials (Server-side only)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend API Base URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Docker Compose PostgreSQL Database Credentials
POSTGRES_DB=llm_evalops
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
